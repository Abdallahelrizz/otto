# ── Required — generate both with: openssl rand -hex 32 ──────────────────────
CREDENTIAL_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32
API_KEY_PEPPER=replace_with_output_of_openssl_rand_hex_32

# ── Database (only needed if not using docker-compose) ────────────────────────
# docker-compose sets this automatically. For Railway/external PG:
DATABASE_URL=postgresql://otto:otto_dev@localhost:5432/otto

# ── Redis (only needed if not using docker-compose) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Code node sandbox (Piston) ────────────────────────────────────────────────
PISTON_URL=http://localhost:2000

# ── Postgres password (docker-compose only) ───────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Network ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional: fallback LLM keys (nodes use saved credentials first) ──────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Tuning ────────────────────────────────────────────────────────────────────
SESSION_DAYS=7
WORKER_CONCURRENCY=10
EXECUTION_RETENTION_DAYS=30
API_RATE_LIMIT=1000
EXEC_RATE_LIMIT=100
