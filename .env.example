# ── Required — generate both with: openssl rand -hex 32 ──────────────────────
CREDENTIAL_ENCRYPTION_KEY=replace_with_output_of_openssl_rand_hex_32
API_KEY_PEPPER=replace_with_output_of_openssl_rand_hex_32

# ── Database (only needed if not using docker-compose) ────────────────────────
# docker-compose sets this automatically. For Railway/external PG:
DATABASE_URL=postgresql://otto:otto_dev@localhost:5432/otto

# ── Redis (only needed if not using docker-compose) ───────────────────────────
REDIS_URL=redis://localhost:6379

# ── Code node sandbox (Piston) ────────────────────────────────────────────────
PISTON_URL=http://localhost:2000

# ── Postgres password (docker-compose only) ───────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Network ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000

# ── Optional: fallback LLM keys (nodes use saved credentials first) ──────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Tuning ────────────────────────────────────────────────────────────────────
SESSION_DAYS=7
WORKER_CONCURRENCY=10
EXECUTION_RETENTION_DAYS=30
API_RATE_LIMIT=1000
EXEC_RATE_LIMIT=100

# ── Security switches ─────────────────────────────────────────────────────────
# These were previously undocumented, which meant an operator could not harden what
# they did not know existed. Defaults are the SAFE values; you only set these to
# deliberately loosen (or, for OTTO_HOSTED, to tighten) behaviour.

# Set true for a hosted / multi-tenant deployment. Makes SSRF_ALLOW_PRIVATE
# impossible to enable, so egress filtering cannot be turned off.
# ⚠️ Read the multi-tenancy caveat in SECURITY.md first — `vm` is not an isolation
# boundary, so Otto is designed for single-tenant self-hosting.
OTTO_HOSTED=false

# Total bypass of the SSRF egress guard — lets workflows reach private/reserved IPs.
# Only for trusted internal self-hosted use. Ignored when OTTO_HOSTED=true.
SSRF_ALLOW_PRIVATE=false

# Allow the Code node to fall back to the PUBLIC emkc.org Piston when PISTON_URL is
# unreachable. That sends your code AND input data off-box, so it is opt-in.
PISTON_ALLOW_PUBLIC=false

# Let the postgres_query node connect to Otto's own database. Off by default: it
# would allow arbitrary SQL over users / api_keys / credentials.
POSTGRES_NODE_ALLOW_SYSTEM_DB=false

# Require a bearer token on GET /metrics. Leave unset to serve it unauthenticated.
METRICS_TOKEN=

# Force the Secure flag on cookies. Set true when terminating TLS at a proxy so
# NODE_ENV alone does not decide it.
FORCE_SECURE_COOKIES=false

# ── Limits ────────────────────────────────────────────────────────────────────
# Max bytes for any single binary payload (file read, S3 download) before it is
# rejected. Guards memory and the Postgres row size.
BINARY_DATA_MAX_BYTES=10485760

# Hard ceiling on distinct rate-limit keys held in memory, so attacker-controlled
# keys cannot grow the map without bound.
RATE_LIMIT_MAX_KEYS=100000

# ── Storage ───────────────────────────────────────────────────────────────────
# Root directory the file nodes (read_file / write_file / list_files) are confined
# to. Paths are resolved and realpath-checked against this root.
OTTO_FILES_DIR=

# Fallback S3 settings for the s3_object node when no S3 credential is selected.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=

# ── Boot ──────────────────────────────────────────────────────────────────────
# The server applies pending migrations on startup and refuses to start if they
# fail. Set false only if you run migrations as a separate release step.
# ⚠️ Migrations are the single source of truth for the schema — schema.sql is NOT
# seeded by docker-compose (doing so left the DB half-built and crash-looped boot).
RUN_MIGRATIONS_ON_BOOT=true

# production enables stricter defaults (secure cookies, CORS default-deny, exit on
# uncaught exception so the supervisor restarts clean).
NODE_ENV=development
