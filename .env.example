# ── Copy to .env and fill in real values ──────────────────────────────────────

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://otto:otto_dev@localhost:5432/otto

# Redis (matches docker-compose defaults)
REDIS_URL=redis://localhost:6379

# Credential encryption key — REQUIRED
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_ENCRYPTION_KEY=

# LLM API keys (optional — used as fallback when no credential is attached to a node)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Server
PORT=3000
HOST=0.0.0.0
